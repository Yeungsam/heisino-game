{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "cloud1-d5ghcmrajdca722b5",
  "functionRoot": "functions",
  "functions": [
    {
      "name": "heisino-account",
      "runtime": "Nodejs20.19",
      "type": "HTTP",
      "gatewayPath": "/api/account",
      "installDependency": true,
      "timeout": 20,
      "memorySize": 256,
      "description": "大劫卡西诺微信账号、权威对局与资产结算"
    },
    {
      "name": "heisino-cards",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "description": "大劫卡西诺卡牌目录 API",
      "envVariables": {
        "CARD_ASSET_ORIGIN": "https://cloud1-d5ghcmrajdca722b5-1510428576.tcloudbaseapp.com"
      }
    },
    {
      "name": "heisino-game",
      "runtime": "Nodejs20.19",
      "type": "HTTP",
      "gatewayPath": "/api/search",
      "installDependency": true,
      "timeout": 10,
      "memorySize": 256,
      "description": "大劫卡西诺权威搜索回合 API"
    }
  ]
}
